# Dockerfile
FROM node:20-slim AS app
WORKDIR /app

# build deps for C++ engine
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build && rm -rf /var/lib/apt/lists/*

# Node deps
COPY package*.json ./
RUN npm ci --omit=dev

# App source
COPY . .

# Build C++ engine (adjust source/CMake as needed)
RUN mkdir -p build && cd build && cmake -G Ninja -DCMAKE_BUILD_TYPE=Release .. \
 && ninja \
 && mkdir -p /app/engine \
 && cp /app/build/chess_uci /app/engine/chess_engine \
 && chmod +x /app/engine/chess_engine

ENV PORT=8080
EXPOSE 8080
CMD ["node", "server.js"]
